{
  "name": "my-personal-website",
  "version": "1.10.0",
  "private": true,
  "description": "有间小站：React + JavaScript + CSS + Vite，本地优先的个人网站",
  "type": "module",
  "scripts": {
    "build:optimizer": "node scripts/build-optimizer.mjs",
    "build:pages": "node scripts/build-pages.mjs",
    "start": "node server.mjs",
    "snapshot": "node scripts/refresh-snapshots.mjs",
    "snapshot:github": "node scripts/refresh-snapshots.mjs --github",
    "snapshot:approve": "node scripts/refresh-snapshots.mjs --approve-github",
    "discovery": "node scripts/generate-discovery.mjs",
    "garden": "node scripts/generate-garden.mjs",
    "garden:approve": "node scripts/generate-garden.mjs --approve",
    "dev": "vite --open",
    "build": "vite build",
    "preview": "vite preview",
    "check": "node scripts/check-image-core.mjs && node scripts/check-video-core.mjs",
    "test:e2e": "playwright test",
    "lint": "oxlint src tests vite.config.js playwright.config.js --deny-warnings",
    "verify": "npm run lint && npm run check && npm run build:pages && npm run test:e2e"
  },
  "dependencies": {
    "@jsquash/avif": "2.1.1",
    "@jsquash/jpeg": "1.6.0",
    "@jsquash/resize": "2.1.1",
    "@jsquash/webp": "1.5.0",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@babel/core": "7.29.7",
    "@playwright/test": "1.64.1",
    "@rolldown/plugin-babel": "0.2.4",
    "@vitejs/plugin-react": "6.1.2",
    "babel-plugin-react-compiler": "1.0.0",
    "oxlint": "1.90.0",
    "vite": "8.3.5"
  },
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  }
}
